{
  "name": "offload-inbox",
  "private": true,
  "type": "module",
  "scripts": {
    "db:create": "wrangler d1 create offload",
    "db:schema": "wrangler d1 execute offload --remote --file=schema.sql",
    "dev": "wrangler d1 execute offload --local --file=schema.sql && wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "^3.114.0" }
}
